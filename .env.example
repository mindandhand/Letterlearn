# Copy this file to .env and fill in values from the Volcengine console.
# .env is gitignored; do not commit real credentials.

VOLCENGINE_TTS_APP_ID=
VOLCENGINE_TTS_ACCESS_TOKEN=

# From the Volcengine TTS docs/console. Common HTTP endpoint:
VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v1/tts
VOLCENGINE_TTS_CLUSTER=volcano_tts

# Set one shared voice, or override per accent.
VOLCENGINE_TTS_VOICE_TYPE=
VOLCENGINE_TTS_VOICE_TYPE_US=
VOLCENGINE_TTS_VOICE_TYPE_GB=

# The app reads .m4a files. The script asks Volcengine for wav, then converts
# to m4a with macOS afconvert by default.
VOLCENGINE_TTS_ENCODING=wav
VOLCENGINE_TTS_OUTPUT_FORMAT=m4a

VOLCENGINE_TTS_SPEED_RATIO=0.9
VOLCENGINE_TTS_VOLUME_RATIO=1.0
VOLCENGINE_TTS_PITCH_RATIO=1.0
VOLCENGINE_TTS_DELAY_MS=250
